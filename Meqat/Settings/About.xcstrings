    "Asks GitHub once a day whether a newer version exists. Sends nothing about you or this Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দিনে একবার GitHub-এ জানতে চায় নতুন সংস্করণ আছে কি না। আপনার বা এই ম্যাকের কোনো তথ্য পাঠায় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
