    "Calculated" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিসাব করা"
          }
        }
      }
    },
    "Calculated follows today's prayer times. Static uses the same clock time every day." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিসাব করা সময় আজকের নামাজের সময় মেনে চলে। নির্দিষ্ট সময় প্রতিদিন ঘড়ির একই সময় ব্যবহার করে।"
          }
        }
      }
    },
    "Calculation method" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিসাবের পদ্ধতি"
          }
        }
      }
    },
    "Changes when Asr begins: Hanafi starts it later than Shafi'i." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আসর কখন শুরু হয় তা বদলায়: হানাফী মতে শাফেয়ীর চেয়ে দেরিতে শুরু হয়।"
          }
        }
      }
    },
    "Closes the full-screen alert on its own after this long." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতক্ষণ পরে পূর্ণ-স্ক্রিন সতর্কবার্তা নিজে থেকেই বন্ধ হয়।"
          }
        }
      }
    },
    "Duha always runs from the end of the sunrise forbidden window to the start of the noon one, so a static time does not move it." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাশত সবসময় সূর্যোদয়ের নিষিদ্ধ সময় শেষ হওয়া থেকে দুপুরের নিষিদ্ধ সময় শুরু হওয়া পর্যন্ত চলে, তাই নির্দিষ্ট সময় দিলেও এটি সরে না।"
          }
        }
      }
    },
    "End alert" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষের সতর্কবার্তা"
          }
        }
      }
    },
    "Ends at Dhuhr and starts this long before it." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যোহরে শেষ হয়, শুরু হয় তার এতক্ষণ আগে।"
          }
        }
      }
    },
    "Ends at sunset and starts this long before it." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সূর্যাস্তে শেষ হয়, শুরু হয় তার এতক্ষণ আগে।"
